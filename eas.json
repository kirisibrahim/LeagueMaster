{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_SUPABASE_URL": "@EXPO_PUBLIC_SUPABASE_URL",
          "EXPO_PUBLIC_SUPABASE_ANON_KEY": "@EXPO_PUBLIC_SUPABASE_ANON_KEY",
          "EXPO_PUBLIC_FOOTBALL_API_KEY": "@EXPO_PUBLIC_FOOTBALL_API_KEY",
          "EXPO_PUBLIC_FOOTBALL_API_URL": "@EXPO_PUBLIC_FOOTBALL_API_URL"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
